# === 飞书（可选，缺就不 attach lark transport）===
# 开放平台 → 凭证与基础信息
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === 企业微信（可选，缺就不 attach wecom transport）===
# 企业微信管理后台 → 应用管理 → 你的自建应用
# WECOM_CORP_ID=wx_xxxxxxxxxxxxxxxx
# WECOM_AGENT_ID=1000002
# WECOM_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 「接收消息」页配置：Token / EncodingAESKey / URL
# WECOM_TOKEN=xxxxxxxxxxxxxxxx
# WECOM_AES_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WECOM_CALLBACK_HTTP_PORT=3939              # daemon 内嵌 HTTP receiver 端口（默认 3939）
# WECOM_CALLBACK_URL=https://xxx.trycloudflare.com  # 可选，doctor 用它检测公网可达性
# WECOM_DEFAULT_TO_USER=@all                 # 发消息缺 chatId 时兜底目标（如 @all 或某 userid）

# === Knowledge Extraction（可选）===
# 每次 tab 任务完成时，把输出送 claude -p 提炼成结构化"知识条目"
# 存 ./data/knowledge/<id>.json；后续可用 `agent knowledge search/list` 检索
# 开启后每 pending isFinal 会消耗一次 claude subscription（本地跑，不额外付费）
# KNOWLEDGE_EXTRACT_ENABLED=1

# === Web Dashboard（可选）===
# 手机浏览器打开 http://<mac-name>:<port>/#token=<TOKEN>
# 见 mac 上所有 tab / 派命令 / 抓屏 / 快捷 slash
# WEB_DASHBOARD_TOKEN=$(openssl rand -hex 32)  # 随便生一个 32 位随机串
# WEB_DASHBOARD_PORT=3940                       # 默认 3940（避开企微 3939）
# WEB_DASHBOARD_BIND=0.0.0.0                    # Tailscale 场景保持 0.0.0.0

# 可选：debug | info | warn | error
LOG_LEVEL=info

# === TAPD Bug 监听（可选，缺 URL/TOKEN/NICK 任一则不启）===
# 公司 TAPD MCP 网关（streamable-http）+ Bearer token；监听指派给我的当天缺陷/需求
# TAPD_MCP_URL=https://mcp.xxx.com/servers/<id>/mcp
# TAPD_MCP_TOKEN=<Bearer JWT，勿入库>
# TAPD_NICK=你的TAPD昵称        # current_owner 过滤用（token email 不会自动解析成 nick）
# TAPD_WORKSPACE_IDS=          # 空 = 自动发现我参与的全部项目
# TAPD_SYSTEMS=bug,story       # 监听类型，默认 bug+需求；只要 bug 设 bug
# TAPD_POLL_MS=300000          # 轮询间隔，默认 5min
# 匹配"我"的字段（任一命中即算我的）；不同 TAPD 里"开发负责人"可能是 developer/de 而非 owner：
# TAPD_STORY_OWNER_FIELDS=owner,developer     # 需求默认查 处理人+开发负责人
# TAPD_BUG_OWNER_FIELDS=current_owner,de      # 缺陷默认查 当前处理人+开发人员
# P3：daemon 启动时会幂等把 TAPD MCP 注册给 Claude Code（user scope），
# 认领 bug 开的工作 tab 里的 claude 就能用 mcp__tapd__* 读/改 TAPD。
# 手动注册：claude mcp add --transport http tapd <TAPD_MCP_URL> --header "Authorization: Bearer <TOKEN>" -s user

# === performance-platform 性能建议监听（P1 只读，可选；缺 URL/USER/PASS 任一则不启）===
# 慢查询/性能优化建议(recommendation) → 飞书卡 → 认领开 tab 修。见 docs/perf-integration.md
# PERF_API_URL=http://host:port        # performance-platform-api base（不含 /api）
# PERF_API_USER=<Basic auth 用户名>
# PERF_API_PASS=<Basic auth 密码，勿入库>
# PERF_NICK=你的名字                   # 回写 implementedBy / 未来 owners 匹配用
# PERF_TARGETS=backend,frontend        # 只看这些 target；空=全部
# PERF_PRIORITIES=P0,P1                # 只看这些优先级；默认 P0,P1
# PERF_MY_REPOS=                       # 本地归属过滤(repo 名)；空=全部。多人时每人配自己负责的 repo
# PERF_REPOS_BASE_DIR=/Users/you/ihealth-project   # 本地仓库根，做 repo→localPath 映射
# PERF_POLL_MS=300000                  # 轮询间隔，默认 5min
# --- perf「认领并建需求」目标（可选；建 TAPD 需求走 TAPD_MCP_URL/TOKEN + TAPD_NICK）---
# PERF_TAPD_WORKSPACE_ID=36983849      # 建到哪个 TAPD 项目；默认「后端服务」项目(名字就叫后端服务)
# PERF_TAPD_CATEGORY_ID=1136983849001000190   # 默认「数据库优化」分类(最契合 perf)。同项目其他分类:
#   产品需求 179 / 技术需求 180 / 新功能 181 / 优化需求 182 / 数据安全 187 / 基础架构 188 / 系统监控 189 / 数据库优化 190
#   (id 前缀均 1136983849001000)。留空则不设分类(未分类)
# PERF_TAPD_CATEGORY=                   # 只在没配 CATEGORY_ID 时按分类名解析

# === 任务工作目录（TAPD/perf 认领时建独立目录用，可选）===
# TASK_WORKROOT=~/ihealth-work   # 线上bug建 fix_<id6>/、新需求建 feature_<id6>/ 的根目录；默认 ~/ihealth-work
# 目录里每个 repo 用 git worktree（本地有源，秒建省盘）或 clone（无源）拉进来。
# 开发中需求的bug → 不建新目录，在现有 repo 当前分支直接改。

# === 工作总结定时报告（P3，可选；缺则不启）===
# 到点自动生成并推飞书（每周期只触发一次）。时间为北京时区。
# REPORT_DAILY_AT=18:00        # 每天 18:00 出当日日报（简报）
# REPORT_WEEKLY_AT=Mon 09:00   # 每周一 09:00 出【上周】周报（简报）
# REPORT_MONTHLY_AT=1 09:00    # 每月 1 号 09:00 出【上月】月报（PPT）
