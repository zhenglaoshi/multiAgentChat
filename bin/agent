#!/usr/bin/env bash
# multiAgentChat CLI shim
# Always resolves to the monorepo root so `agent` works from any cwd.
# NOTE: daemon symlinks this to ~/.local/bin/agent, so we must follow symlinks
# to the real file — else ROOT resolves to ~/.local and tsx can't find the pkg.
set -e
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
HERE="$(cd -P "$(dirname "$SOURCE")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
exec npx --prefix "$ROOT" tsx "$ROOT/packages/framework/src/control/cli.ts" "$@"
