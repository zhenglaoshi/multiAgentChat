#!/usr/bin/env node
/*
 * multiAgentChat — Claude Code Stop hook
 *
 * ~/.claude/settings.json 的 hooks.Stop 指向本脚本。Claude Code 每次
 * assistant 响应完成会调本脚本，stdin 是 JSON（含 last_assistant_message /
 * cwd / session_id）。本脚本抽 last_assistant_message，通过
 * `bin/agent lark send-text --auto` 推到飞书；daemon 根据目标 chat 的
 * watchAllTabs 决定是否放行。
 *
 * Fire-and-forget：spawn detached，hook 立即 exit 0，
 * 不阻塞 Claude Code 的 Stop 流程。任何异常都吞掉（exit 0），
 * 避免 hook 报错影响用户 UI。
 *
 * 设 MCHAT_HOOK_DEBUG=1 打开 /tmp/mchat-stop-hook.log 调试。
 *
 * NOTE: 必须用 ESM —— monorepo root package.json 声明 "type": "module"，
 *       Node 会把无扩展名脚本按 ESM 加载；require() 会 ReferenceError
 *       导致 hook crash（曾经的一个坑）。
 */
import { spawn, execFileSync } from 'node:child_process';
import { appendFileSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const HERE = dirname(fileURLToPath(import.meta.url));
const MAX_TEXT_LEN = 3500;
// 短消息降噪：< 40 chars 的 assistant 响应（e.g. "OK"/"已完成"/"处理中"）不推飞书，
// 手机端不刷屏。可通过 MCHAT_STOP_MIN_LEN=N 覆盖（0 = 全推，恢复旧行为）。
const MIN_TEXT_LEN = (() => {
  const v = process.env['MCHAT_STOP_MIN_LEN'];
  if (v === undefined) return 40;
  const n = Number(v);
  return Number.isFinite(n) && n >= 0 ? n : 40;
})();
const DEBUG = process.env['MCHAT_HOOK_DEBUG'] === '1';
const DEBUG_LOG = '/tmp/mchat-stop-hook.log';

function dbg(msg) {
  if (!DEBUG) return;
  try {
    appendFileSync(DEBUG_LOG, `[${new Date().toISOString()}] ${msg}\n`);
  } catch {}
}

/*
 * 是否 headless / 内部 `claude -p` 会话 —— 这类不该把输出推飞书：
 *   - 全局装在 ~/.claude/settings.json 的本 hook 会对整台机器上 **任何** claude
 *     会话触发，包括知识提炼 / 其它自动化跑的 `claude -p`（非交互、没对应 tab），
 *     它们的 meta 回复（"请提供数据…"之类）泄漏到飞书是噪音。
 * 判定（命中任一即 headless）：
 *   1. 环境变量 MCHAT_INTERNAL_SESSION=1（本项目内部 spawn claude 时设，hook 子进程继承）
 *   2. 触发本 hook 的父 claude 进程命令行含 -p / --print（覆盖外部任意 headless 调用）
 * 拿不准时返回 false（照旧推送），只在 **确定** headless 时才屏蔽。
 */
function isHeadlessSession() {
  if (process.env['MCHAT_INTERNAL_SESSION'] === '1') return true;
  try {
    const cmd = execFileSync('ps', ['-o', 'command=', '-p', String(process.ppid)], {
      encoding: 'utf8',
    }).trim();
    if (/(^|\s)(-p|--print)(\s|$)/.test(cmd)) return true;
  } catch {
    /* ps 失败 → 当作交互式，照旧推 */
  }
  return false;
}

/*
 * 内容特征过滤 —— 拦"知识提取 / 协作效率评估器"这类工具的 meta 输出。
 * 这类跑在**完整交互式 claude**（命令行没 -p，headless 检测抓不到）里，输出的是
 * "缺少输入，请提供数据…我会输出 {corrections,one_shot,prompt_quality} + 知识数组"
 * 之类的 meta 回复 —— 对飞书是纯噪音。它们的 JSON schema 词几乎不会出现在正常回复里，
 * 拿它们当签名，误报极低。可用 MCHAT_STOP_NO_META_FILTER=1 关掉本过滤。
 */
function looksLikeInternalMeta(text) {
  if (process.env['MCHAT_STOP_NO_META_FILTER'] === '1') return false;
  const t = text;
  // —— 强签名：JSON schema 专有 key（下划线形态）/ 中文评估器专有词，正常回复几乎不出现，单条命中即判定 ——
  if (/prompt_quality/.test(t)) return true;                          // 评分 schema key（下划线）
  if (/corrections/.test(t) && /one_shot/.test(t)) return true;       // 评分 schema 组合（下划线）
  if (/协作效率/.test(t)) return true;                                 // 中文评估器专有词
  // —— 知识提取器"要数据"型 meta（中文）：提炼/提取知识条目 + 请提供/缺少输入/粘贴 ——
  if (/(提炼|提取)[^。\n]{0,8}知识条目/.test(t) && /(请提供|缺少输入|粘贴过来)/.test(t)) {
    return true;
  }
  // —— 英文 meta：散文里的 "prompt quality"/"one-shot"/"collaboration efficiency"/"knowledge entries"
  //    在本项目语境（多 agent 协作、prompt 设计）都是常用词，单条命中会误吞正常回复（违反"必须推飞书"）。
  //    这类工具的噪音特征是"输入为空、向你要数据"，故要求【缺输入/请求数据措辞】+【评估器/知识词】**共现**
  //    才判定 —— 精准打"你没给我数据"的澄清话，不误杀真结果或正常讨论。 ——
  const asksForData = /(message is incomplete|you haven'?t provided|please provide the|provide the actual|paste them|point me to a file)/i.test(t);
  // 四个分支都带 \b 词边界：否则 "one shot" 会被 "someone shot"/"anyone shot" 借壳命中，
  // 叠加 asksForData 后误吞正常回复（如 "Someone shot down my PR, please provide the diff"）。
  const evalOrKnow = /(\bprompt[\s_-]?quality\b|\bone[\s_-]?shot\b|\bcollaboration\s+(?:metrics|efficiency)\b|\bknowledge\s+entr(?:y|ies)\b)/i.test(t);
  if (asksForData && evalOrKnow) return true;
  return false;
}

let raw = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (chunk) => {
  raw += chunk;
});
process.stdin.on('error', () => process.exit(0));
process.stdin.on('end', () => {
  try {
    if (!raw.trim()) return process.exit(0);
    const payload = JSON.parse(raw);
    // headless / 内部 claude -p 会话不推飞书（知识提炼等自动化的 meta 输出属噪音）
    if (isHeadlessSession()) {
      dbg(`skip: headless/internal session (ppid=${process.ppid})`);
      return process.exit(0);
    }
    let text = payload.last_assistant_message;
    if (typeof text !== 'string' || !text.trim()) return process.exit(0);
    // 内容特征过滤：知识提取 / 协作效率评估器的 meta 输出不推飞书
    if (looksLikeInternalMeta(text)) {
      dbg('skip: internal-tool meta output (efficiency/knowledge evaluator)');
      return process.exit(0);
    }
    // 长度降噪：短确认（"OK"、"已完成 X"）不推飞书
    const trimmedLen = text.trim().length;
    if (trimmedLen < MIN_TEXT_LEN) {
      dbg(`skip: too short (len=${trimmedLen} < ${MIN_TEXT_LEN})`);
      return process.exit(0);
    }
    if (text.length > MAX_TEXT_LEN) {
      text = text.slice(0, MAX_TEXT_LEN) + '\n\n…(truncated)';
    }
    const agentBin = resolve(HERE, 'agent');
    // 传 ppid + cwd 让 daemon 反查触发本 hook 的 shell tab，加 [ttys004] 前缀区分
    // 多 shell 场景。Stop hook 不带 --question：它不产生"待用户回答"，仅上下文标注。
    const args = ['lark', 'send-text', '--auto', '--origin-pid', String(process.ppid)];
    if (typeof payload.cwd === 'string' && payload.cwd) {
      args.push('--origin-cwd', payload.cwd);
    }
    dbg(`spawn: session=${payload.session_id} text.len=${text.length} ppid=${process.ppid} cwd=${payload.cwd ?? ''}`);
    const proc = spawn(agentBin, args, {
      stdio: ['pipe', 'ignore', 'ignore'],
      detached: true,
    });
    proc.on('error', (e) => dbg('spawn error: ' + e.message));
    proc.stdin.end(text);
    proc.unref();
    process.exit(0);
  } catch (e) {
    dbg('caught: ' + (e && e.message));
    process.exit(0);
  }
});
