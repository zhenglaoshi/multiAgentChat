{
  "name": "multiagent-chat",
  "version": "0.0.1",
  "private": true,
  "description": "Local multi-agent orchestrator with mobile IM bridge (monorepo root)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent": "./bin/agent"
  },
  "scripts": {
    "dev": "tsx watch apps/daemon/src/index.ts",
    "start": "tsx apps/daemon/src/index.ts",
    "agent": "tsx packages/framework/src/control/cli.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "gen:feishu-commands": "tsx scripts/gen-feishu-commands.ts",
    "verify:feishu-commands": "tsx scripts/gen-feishu-commands.ts --verify"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
