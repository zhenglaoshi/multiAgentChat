{
  "name": "multiagent-chat",
  "version": "0.0.1",
  "private": true,
  "description": "Local multi-agent orchestrator with mobile IM bridge (monorepo root)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent": "./bin/agent"
  },
  "scripts": {
    "dev": "tsx watch apps/daemon/src/index.ts",
    "start": "tsx apps/daemon/src/index.ts",
    "daemon:install": "bash scripts/launchd-setup.sh install",
    "daemon:uninstall": "bash scripts/launchd-setup.sh uninstall",
    "daemon:status": "bash scripts/launchd-setup.sh status",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent": "tsx packages/framework/src/control/cli.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "check:boot": "tsx scripts/check-boot.ts",
    "gen:feishu-commands": "tsx scripts/gen-feishu-commands.ts",
    "verify:feishu-commands": "tsx scripts/gen-feishu-commands.ts --verify"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
