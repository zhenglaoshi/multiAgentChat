{
  "name": "multi-agent-chat",
  "version": "0.0.1",
  "private": true,
  "description": "Local multi-agent orchestrator with mobile IM bridge",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent": "./bin/agent"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "agent": "tsx src/control/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.40.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
